# Model providers for the local stack. setup.sh copies this file to
# config/models.env, which is gitignored because it holds your API key.
#
# Nothing here is a default: the stack names no model provider of its own.
# Replace every REPLACE-ME. Any OpenAI-compatible chat endpoint works.
#
# Extraction: every changed document goes through this model, several calls
# per document, so ingest costs model calls (docs/models.md).
KI_LLM_BASE_URL=REPLACE-ME
KI_LLM_MODEL=REPLACE-ME
KI_LLM_API_KEY=REPLACE-ME
# json_schema sends a native response format. If your provider refuses it, use
# json_object (JSON mode) or prompt (schema in the prompt only); see docs/models.md.
KI_LLM_STRUCTURED_MODE=json_schema
# Documents committed less than this many minutes ago wait for a later run.
# 0 ingests everything at the next sync, which suits a first run.
KI_INGEST_QUIET_MINUTES=0
#
# Embeddings: the text-embeddings-inference service in compose.yaml, serving the
# same model as the cluster (deploy/kb/embeddings.yaml), so embedding never
# leaves this machine. Its key is EMBEDDING_API_KEY in .env, written by setup.sh.
# Ingest and queries must use the same model: changing it means re-ingesting.
KI_EMBEDDING_BASE_URL=http://embeddings:8080/v1
KI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KI_EMBEDDING_DIM=384
