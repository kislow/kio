# Model providers for every brain. Any OpenAI-compatible endpoint works.
#
# Extraction: Claude Haiku 5.5 through Anthropic's OpenAI-compatible endpoint
# (decision 2026-10-19, measured on one project brain against DeepSeek Flash,
# Haiku 4.5 and Sonnet 5.5: a graph on par with DeepSeek, no schema re-asks,
# about a third of Sonnet's price). The key is kb-secrets/llm-api-key.
# That endpoint accepts only strict JSON schemas and refuses `temperature`
# on 5.5 models, so KI_LLM_STRUCTURED_MODE=prompt puts the schema in the
# prompt, drops both, and trims the answer to its first JSON value.
# Going back to DeepSeek: base URL https://api.deepseek.com, model
# deepseek-flash, mode json_object, KI_LLM_THINKING=false (its reasoning
# switch; max_tokens caps reasoning and answer together, hence 32768), and
# kb-secrets/llm-api-key mapped to the DeepSeek key in your secrets operator,
# plus KI_LLM_PEAK_UTC and KI_LLM_BALANCE_URL below.
KI_LLM_BASE_URL=https://api.anthropic.com/v1
KI_LLM_MODEL=claude-haiku-5-5
KI_LLM_STRUCTURED_MODE=prompt
KI_LLM_MAX_TOKENS=32768
KI_LLM_THINKING=true
# A document committed within the last 30 minutes waits for a later run, so a
# note pushed several times while you edit it is extracted once (about thirty
# model calls per extraction). Runs report such documents as "deferred".
KI_INGEST_QUIET_MINUTES=30
# Documents per Graphiti bulk call within one graph; each graph is its own
# lane and lanes run side by side. 1 restores one-at-a-time add_episode.
KI_INGEST_BATCH=16
# Bulk ingest waits for off-peak: a project with more than
# KI_INGEST_BULK_THRESHOLD documents waiting, or `bulk: true` in projects.yaml,
# is deferred during these UTC windows (reason "peak"); smaller changes go
# through at any hour. Empty means no windows, right for Anthropic's flat price.
# DeepSeek bills double at Mon-Fri 01:00-04:00,06:00-10:00.
KI_LLM_PEAK_UTC=
KI_INGEST_BULK_THRESHOLD=25
# Balance guard, off while the URL is empty (Anthropic has no balance endpoint).
# DeepSeek: https://api.deepseek.com/user/balance, read with the LLM key once
# per run and between bulk batches. Below the floor in USD, or unreadable,
# bulk waits (reason "balance").
KI_LLM_BALANCE_URL=
KI_LLM_MIN_BALANCE=5
KI_LLM_BALANCE_CHECK_INTERVAL_MINUTES=10
#
# Embeddings: run in the cluster, independent of the extraction provider:
# BAAI/bge-small-en-v1.5 on text-embeddings-inference (deploy/kb/embeddings.yaml).
# Ingest and queries must use the same model: changing it means re-embedding.
KI_EMBEDDING_BASE_URL=http://embeddings.harness.svc.cluster.local:8080/v1
KI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KI_EMBEDDING_DIM=384
# One FalkorDB pool for every graph lane of a sync. Three lanes (a bulk project)
# times Graphiti's nested gathers at SEMAPHORE_LIMIT 10 is 300. A full pool
# waits; it does not fail the batch with MaxConnectionsError. Raise this when
# SEMAPHORE_LIMIT goes up.
KI_FALKORDB_MAX_CONNECTIONS=300
