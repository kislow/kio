# Model providers for every brain. Any OpenAI-compatible endpoint works; see
# docs/models.md for the DeepSeek and Anthropic settings.
KI_LLM_BASE_URL=https://api.anthropic.com/v1
KI_LLM_MODEL=claude-haiku-5-5
KI_LLM_STRUCTURED_MODE=prompt
KI_LLM_MAX_TOKENS=32768
KI_LLM_THINKING=true
KI_INGEST_QUIET_MINUTES=30
KI_INGEST_BATCH=16
KI_LLM_PEAK_UTC=
KI_INGEST_BULK_THRESHOLD=25
KI_LLM_BALANCE_URL=
KI_LLM_MIN_BALANCE=5
KI_LLM_BALANCE_CHECK_INTERVAL_MINUTES=10
KI_EMBEDDING_BASE_URL=http://embeddings.harness.svc.cluster.local:8080/v1
KI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KI_EMBEDDING_DIM=384
# One FalkorDB pool for every graph lane of a sync. Three lanes times
# Graphiti's nested gathers at SEMAPHORE_LIMIT 10 is 300. A full pool waits;
# it does not fail the batch with MaxConnectionsError.
KI_FALKORDB_MAX_CONNECTIONS=300
